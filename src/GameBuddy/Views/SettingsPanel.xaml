<UserControl x:Class="GameBuddy.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GameBuddy.ViewModels"
             xmlns:models="clr-namespace:GameBuddy.Models"
             xmlns:conv="clr-namespace:GameBuddy.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="TrueVisible"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,32" MaxWidth="720">

            <TextBlock Text="设置" Style="{StaticResource TitleText}" Margin="0,0,0,18"/>

            <!-- 扫描来源 -->
            <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="扫描来源" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Steam 安装目录（留空自动探测）" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Settings.SteamPathOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0"
                                Command="{Binding BrowseSteamPathCommand}"/>
                    </Grid>

                    <TextBlock Text="Epic Manifests 目录（留空自动探测）" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Settings.EpicManifestsPathOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0"
                                Command="{Binding BrowseEpicPathCommand}"/>
                    </Grid>

                    <TextBlock Text="额外监控目录" Style="{StaticResource MutedText}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Settings.WatchFolders}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="1" Content="移除" Margin="8,0,0,0" Padding="8,3"
                                            Command="{Binding DataContext.RemoveWatchFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <Button Content="＋ 添加目录" Margin="0,0,8,0" Command="{Binding AddWatchFolderCommand}"/>
                        <Button Content="🔄 立即扫描" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 元数据 -->
            <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="元数据" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Content="扫描后自动抓取海报与简介（Steam Store API）"
                              IsChecked="{Binding Settings.AutoFetchMetadata, Mode=TwoWay}" Margin="0,0,0,8"/>
                    <CheckBox Content="在库中显示已隐藏的游戏"
                              IsChecked="{Binding Settings.ShowHiddenGames, Mode=TwoWay}" Margin="0,0,0,6"/>
                    <CheckBox Content="在库中显示已卸载的游戏（灰显并标注）"
                              IsChecked="{Binding Settings.ShowUninstalledGames, Mode=TwoWay}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="🔄 补齐缺失元数据" Margin="0,0,8,0" Command="{Binding RefreshMetadataCommand}"/>
                        <Button Content="♻ 全部强制刷新" Command="{Binding ForceRefreshMetadataCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="提示：非 Steam 游戏会按名称在 Steam 商店搜索匹配，可在右侧详情里手动填写 AppId 纠正。"
                               Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 分组 -->
            <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="分组管理" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GameGroup}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                                            Background="{Binding ColorHex}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,3"/>
                                    <Button Grid.Column="2" Content="删除" Margin="8,0,0,0" Padding="8,3"
                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="＋ 新建分组" HorizontalAlignment="Left" Command="{Binding AddGroupCommand}"/>
                </StackPanel>
            </Border>

            <!-- 库维护 -->
            <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="库维护" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding IgnoredCountText}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="♻ 重置忽略列表" Margin="0,0,8,0" Command="{Binding ResetIgnoredGamesCommand}"/>
                        <Button Content="🔄 立即扫描" Command="{Binding ScanCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="被合并掉的重复条目、以及你手动移除过的条目都会记进忽略列表，下次扫描不会再出现。重新安装游戏后，先点“重置忽略列表”再扫描一次即可找回。"
                               Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 主题 -->
            <Border Style="{StaticResource PanelBorder}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="主题插件" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Themes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ThemeDescriptor}">
                                <Button Margin="0,0,0,8" Padding="12" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="5" Margin="0,0,12,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding PreviewColorHex}"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="✓ 使用中" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource Theme.AccentBrush}"
                                                   Visibility="{Binding IsApplied, Converter={StaticResource TrueVisible}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <Button Content="🔄 重新加载主题" Margin="0,0,8,0" Command="{Binding ReloadThemesCommand}"/>
                        <Button Content="📁 打开主题目录" Command="{Binding OpenThemesFolderCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="把主题文件夹放到 %LOCALAPPDATA%\GameBuddy\Themes\ 下（含 theme.json + Theme.xaml）即可作为插件加载。"
                               Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 数据 -->
            <Border Style="{StaticResource PanelBorder}" Padding="16">
                <StackPanel>
                    <TextBlock Text="数据" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel>
                        <Button Content="📁 打开数据目录" Margin="0,0,8,0" Command="{Binding OpenDataFolderCommand}"/>
                        <Button Content="💾 保存设置" Command="{Binding SaveSettingsCommand}"/>
                    </WrapPanel>
                    <TextBlock Text="库文件、游玩记录与海报缓存都存放在该目录；删除目录会清空全部统计数据。"
                               Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
