<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 赛博朋克：霓虹青紫、发光描边、切角卡片 -->
    <SolidColorBrush x:Key="Theme.WindowBackgroundBrush" Color="#FF08070F"/>
    <SolidColorBrush x:Key="Theme.SidebarBrush" Color="#FF0C0A17"/>
    <SolidColorBrush x:Key="Theme.TopBarBrush" Color="#FF120E22"/>
    <SolidColorBrush x:Key="Theme.SurfaceBrush" Color="#FF130F24"/>
    <SolidColorBrush x:Key="Theme.CardBrush" Color="#FF1A1430"/>
    <SolidColorBrush x:Key="Theme.CardHoverBrush" Color="#FF261C4A"/>
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="#FF3A2A6B"/>
    <SolidColorBrush x:Key="Theme.DividerBrush" Color="#FF241A44"/>
    <SolidColorBrush x:Key="Theme.SelectionBrush" Color="#FF1F3355"/>

    <SolidColorBrush x:Key="Theme.AccentBrush" Color="#FF00F0FF"/>
    <SolidColorBrush x:Key="Theme.AccentHoverBrush" Color="#FF7DF9FF"/>
    <SolidColorBrush x:Key="Theme.AccentTextBrush" Color="#FF04121A"/>

    <SolidColorBrush x:Key="Theme.TextPrimaryBrush" Color="#FFE9F6FF"/>
    <SolidColorBrush x:Key="Theme.TextSecondaryBrush" Color="#FF9FB6D6"/>
    <SolidColorBrush x:Key="Theme.TextMutedBrush" Color="#FF6C7FA6"/>

    <SolidColorBrush x:Key="Theme.SuccessBrush" Color="#FF2BFF88"/>
    <SolidColorBrush x:Key="Theme.WarningBrush" Color="#FFFFE45E"/>
    <SolidColorBrush x:Key="Theme.DangerBrush" Color="#FFFF2E6B"/>
    <SolidColorBrush x:Key="Theme.GlowBrush" Color="#6600F0FF"/>
    <SolidColorBrush x:Key="Theme.PlaceholderBrush" Color="#FF2A2150"/>

    <CornerRadius x:Key="Theme.CardCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="Theme.ButtonCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="Theme.PosterCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="Theme.ControlCornerRadius">2</CornerRadius>

    <FontFamily x:Key="Theme.BaseFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Theme.TitleFontFamily">Segoe UI Semibold, Microsoft YaHei UI</FontFamily>

    <Thickness x:Key="Theme.CardBorderThickness">1</Thickness>
    <Thickness x:Key="Theme.CardPadding">10</Thickness>

    <DropShadowEffect x:Key="Theme.CardEffect" BlurRadius="18" ShadowDepth="0" Opacity="0.85" Color="#FF00F0FF"/>
    <DropShadowEffect x:Key="Theme.PanelEffect" BlurRadius="30" ShadowDepth="0" Opacity="0.7" Color="#FFFF2E97"/>

</ResourceDictionary>
