<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 像素风：PICO-8 调色板 + 等宽字体 + 无圆角硬边框 -->
    <SolidColorBrush x:Key="Theme.WindowBackgroundBrush" Color="#FF1A1C2C"/>
    <SolidColorBrush x:Key="Theme.SidebarBrush" Color="#FF141821"/>
    <SolidColorBrush x:Key="Theme.TopBarBrush" Color="#FF1D2B53"/>
    <SolidColorBrush x:Key="Theme.SurfaceBrush" Color="#FF20243A"/>
    <SolidColorBrush x:Key="Theme.CardBrush" Color="#FF29366F"/>
    <SolidColorBrush x:Key="Theme.CardHoverBrush" Color="#FF3B4FA0"/>
    <SolidColorBrush x:Key="Theme.BorderBrush" Color="#FF5F574F"/>
    <SolidColorBrush x:Key="Theme.DividerBrush" Color="#FF3B4259"/>
    <SolidColorBrush x:Key="Theme.SelectionBrush" Color="#FF008751"/>

    <SolidColorBrush x:Key="Theme.AccentBrush" Color="#FFFFEC27"/>
    <SolidColorBrush x:Key="Theme.AccentHoverBrush" Color="#FFFFA300"/>
    <SolidColorBrush x:Key="Theme.AccentTextBrush" Color="#FF1A1C2C"/>

    <SolidColorBrush x:Key="Theme.TextPrimaryBrush" Color="#FFFFF1E8"/>
    <SolidColorBrush x:Key="Theme.TextSecondaryBrush" Color="#FFC2C3C7"/>
    <SolidColorBrush x:Key="Theme.TextMutedBrush" Color="#FF83769C"/>

    <SolidColorBrush x:Key="Theme.SuccessBrush" Color="#FF00E436"/>
    <SolidColorBrush x:Key="Theme.WarningBrush" Color="#FFFFA300"/>
    <SolidColorBrush x:Key="Theme.DangerBrush" Color="#FFFF004D"/>
    <SolidColorBrush x:Key="Theme.GlowBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="Theme.PlaceholderBrush" Color="#FF3B4259"/>

    <CornerRadius x:Key="Theme.CardCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="Theme.ButtonCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="Theme.PosterCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="Theme.ControlCornerRadius">0</CornerRadius>

    <FontFamily x:Key="Theme.BaseFontFamily">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Theme.TitleFontFamily">Consolas, Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <Thickness x:Key="Theme.CardBorderThickness">2</Thickness>
    <Thickness x:Key="Theme.CardPadding">8</Thickness>

    <DropShadowEffect x:Key="Theme.CardEffect" BlurRadius="0" ShadowDepth="4" Opacity="0.9" Color="#FF000000"/>
    <DropShadowEffect x:Key="Theme.PanelEffect" BlurRadius="0" ShadowDepth="6" Opacity="0.9" Color="#FF000000"/>

</ResourceDictionary>
